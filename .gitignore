workers/

# ── Secrets & local env ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Dependencies & tooling ───────────────────────────────────────────────────
node_modules/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Binaries / installers (don’t commit; Firebase Hosting Spark blocks many executables) ──
*.apk
*.aab
*.ipa
*.exe
*.msi
*.dmg

# ── Editors ──────────────────────────────────────────────────────────────────
.idea/

# ── Claude Code (local worktrees, sessions, agent state) ─────────────────────
.claude/
